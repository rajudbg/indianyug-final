# ── WordPress ────────────────────────────────────────────────────────────────
# Your headless WordPress REST API base URL
WORDPRESS_API_URL=https://cms.indianyug.com/wp-json/wp/v2

# ── Site ─────────────────────────────────────────────────────────────────────
# Production domain (no trailing slash) — used in sitemap, OG, JSON-LD
NEXT_PUBLIC_SITE_URL=https://indianyug.com

# ── Google Analytics ─────────────────────────────────────────────────────────
# GA4 Measurement ID — Analytics > Admin > Data Streams > your stream
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google AdSense ────────────────────────────────────────────────────────────
# Publisher ID — AdSense > Account > Publisher ID (ca-pub-...)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Ad slot IDs — AdSense > Ads > By ad unit > each slot's ID
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX

# ── On-demand Revalidation (WordPress webhook) ────────────────────────────────
# A secret string you choose — add to WordPress webhook URL as ?secret=VALUE
# Configure in: WordPress > WP Webhooks plugin > POST https://indianyug.com/api/revalidate?secret=VALUE
REVALIDATION_SECRET=your-secret-here

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key — resend.com > API Keys
RESEND_API_KEY=re_XXXXXXXXXX
