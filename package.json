{
  "name": "indianyug-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "postbuild": "next-sitemap && node scripts/generate-news-sitemap.js",
    "generate-sitemaps": "node scripts/generate-news-sitemap.js",
    "deploy:optimize": "node scripts/deploy-optimize.js",
    "prebuild": "npm run deploy:optimize",
    "pages:build": "npx @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion && cp .open-next/worker.js .open-next/assets/_worker.js",
    "pages:dev": "npx @opennextjs/cloudflare dev",
    "pages:preview": "npm run build && wrangler pages dev .vercel/output/static",
    "pages:deploy": "npm run build && wrangler pages deploy .vercel/output/static",
    "analyze": "cross-env ANALYZE=true npm run build",
    "analyze:server": "cross-env ANALYZE=true npm run build",
    "analyze:browser": "cross-env ANALYZE=true npm run build",
    "perf:check": "node scripts/performance-check.js",
    "perf:test": "npm run perf:check && npm run build"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^14.2.33",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.0.0",
    "critters": "^0.0.23",
    "cross-env": "^7.0.3",
    "date-fns": "^2.30.0",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^10.16.4",
    "html-react-parser": "^4.2.2",
    "lucide-react": "^0.294.0",
    "next": "^14.2.33",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.2.1",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^4.7.0",
    "swr": "^2.2.4",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.19.4",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.51.0",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "wrangler": "^4.84.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.2.4"
}